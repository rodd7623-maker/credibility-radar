{
  "expo": {
    "name": "Credibility Radar",
    "slug": "credibility-radar",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "credibilityradar",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.credibilityradar.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Credibility Radar needs microphone access to transcribe voice input for analysis. Audio is processed only when you actively start a recording.",
        "NSPhotoLibraryUsageDescription": "Credibility Radar needs photo library access if you choose to attach screenshots or text-bearing images for analysis.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "package": "com.credibilityradar.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Credibility Radar needs photo library access if you choose to attach screenshots or text-bearing images for analysis."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Credibility Radar needs microphone access to transcribe voice input for analysis."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8b218623-2ef5-4e22-8753-e7447e364ea6"
      }
    }
  }
}
